# Copy this file to .env and fill values
AI_PROVIDER=google
GOOGLE_API_KEY=your_google_api_key_here
#ANTHROPIC_API_KEY=your_anthropic_api_key_here
TEST_MODE=false
POST_TIME_HOUR=11
POST_TIME_MINUTE=0
TIMEZONE=Asia/Kolkata
MIN_POST_LENGTH=150
MAX_POST_LENGTH=1000

#optional
ENABLE_MARKET_GROUNDING=true
GROUND_TOKENS=bitcoin,ethereum
CONTENT_PROFILE=arab_global_crypto

LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PERSON_ID=your_linkedin_person_id_here
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
TIMEZONE=Asia/Kolkata

# Supabase auth (required for /login and user management)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
AUTH_PREFER_HTTP=true
AUTH_SDK_TIMEOUT=30
AUTH_HTTP_TIMEOUT=45
AUTH_HTTP_CONNECT_TIMEOUT=10
AUTH_HTTP_READ_TIMEOUT=45
AUTH_HTTP_RETRIES=4
AUTH_HTTP_RETRY_DELAY_SEC=1.0

# Admin panel login
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-strong-password

# Billing (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxx
PLAN_PRICE_1_MONTH_INR=999
PLAN_PRICE_3_MONTH_INR=2499
PLAN_PRICE_12_MONTH_INR=8999
