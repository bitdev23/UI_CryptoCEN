{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptocen.local/benchmarks/generation_quality_suite.schema.json",
  "title": "Generation Quality Suite",
  "type": "object",
  "required": ["suite_name", "cases"],
  "properties": {
    "suite_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "industry", "topic", "expectations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "industry": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "template_id": { "type": "string" },
          "kb_mode": {
            "type": "string",
            "enum": ["no_kb", "use_kb", "specific_files"]
          },
          "grounding_mode": {
            "type": "string",
            "enum": ["strict", "balanced", "creative"]
          },
          "specific_file_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expectations": {
            "type": "object",
            "properties": {
              "must_include": {
                "type": "array",
                "items": { "type": "string" }
              },
              "must_not_include": {
                "type": "array",
                "items": { "type": "string" }
              },
              "min_word_count": {
                "type": "integer",
                "minimum": 10
              },
              "expected_numbers": {
                "type": "array",
                "items": { "type": "number" }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
